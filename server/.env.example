# Intellivora Server Configuration Example
# Copy this file to .env and configure with your actual credentials

# Server Port
PORT=8000

# Environment (development | production)
NODE_ENV=development

# Allowed Client Origin (for CORS and credentials)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/intellivora?retryWrites=true&w=majority

# JWT Authentication Secret Key (minimum 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# AI Provider Credentials
# Primary Provider: OpenRouter (DeepSeek, Llama, Gemma, Mistral)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# Fallback AI Provider: Google Gemini
GEMINI_API_KEY=AIzaSyYourGeminiApiKey

# Payment Gateway: Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

