# Intellivora Client Configuration Example
# Copy this file to .env and configure with your actual credentials

# Backend Server API URL
VITE_SERVER_URL=http://localhost:8000

# Firebase Authentication Configuration
VITE_FIREBASE_APIKEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Razorpay Checkout Public Key (safe for client-side)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Authorized Email Access List (comma-separated, optional)
VITE_ALLOWED_EMAILS=user@example.com,admin@example.com

